

<!DOCTYPE html>

<html lang="en">

<head>

<meta charset="UTF-8">

<meta name="viewport" content="width=device-width,initial-scale=1,maximum-scale=1,user-scalable=no">

<title>ISLAND: AFTERLIGHT</title>

<style>

*{box-sizing:border-box}

body{margin:0;overflow:hidden;background:#17251e;color:white;font-family:Arial,sans-serif;touch-action:none}

canvas{display:block}

#hud{position:fixed;inset:0;pointer-events:none}

.panel{background:#101914d9;border:1px solid #78908066;border-radius:10px;padding:10px}

#stats{position:absolute;top:10px;left:10px;width:190px;font-size:12px}

.bar{height:8px;background:#39443d;border-radius:5px;margin:4px 0 8px;overflow:hidden}

.fill{height:100%;width:100%;background:#60d37b}

#top{position:absolute;top:10px;left:50%;transform:translateX(-50%);text-align:center;white-space:nowrap}

#message{position:absolute;top:100px;left:50%;transform:translateX(-50%);background:#111d;padding:8px 12px;border-radius:8px;font-size:13px}

#inventory{position:absolute;top:10px;right:10px;text-align:right;font-size:12px}

#controls{position:fixed;inset:0;pointer-events:none}

#joy{position:absolute;bottom:24px;left:20px;width:125px;height:125px;border-radius:50%;background:#ffffff1b;border:2px solid #ffffff55;pointer-events:auto;touch-action:none}

#knob{position:absolute;width:48px;height:48px;left:36px;top:36px;border-radius:50%;background:#e4eeeccc}

.buttons{position:absolute;right:15px;bottom:20px;display:grid;grid-template-columns:repeat(2,72px);gap:9px;pointer-events:auto}

button{border:1px solid #ffffff55;border-radius:13px;background:#16241edc;color:white;font-weight:bold;font-size:12px;min-height:54px;padding:8px;touch-action:manipulation}

button:active{background:#587d61}

#hint{position:absolute;bottom:165px;left:50%;transform:translateX(-50%);font-size:11px;color:#eee;white-space:nowrap;text-shadow:0 1px 4px black}

#start{position:fixed;inset:0;background:linear-gradient(#0b1915cc,#0b1915f5);display:flex;align-items:center;justify-content:center;text-align:center;padding:24px;z-index:10}

#start button{font-size:16px;padding:16px 25px;background:#386b45}

.small{font-size:12px;color:#c7d4ca;line-height:1.5}

@media(min-width:800px){#joy{width:140px;height:140px} .buttons{grid-template-columns:repeat(2,85px)}}

</style>

</head>

<body>

<div id="start">

 <div>

  <div style="font-size:12px;letter-spacing:5px;color:#a8d3ad">SURVIVE THE OUTBREAK</div>

  <h1 style="font-size:38px;margin:12px 0">ISLAND:<br>AFTERLIGHT</h1>

  <p class="small">Explore the island. Collect resources.<br>Fight zombies and hostile survivors.</p>

  <button id="play">ENTER THE ISLAND</button>

  <p class="small">Prototype 0.1 · Browser survival</p>

 </div>

</div>

<div id="hud">

 <div id="stats" class="panel">

  <b>SURVIVOR</b>

  <div>❤️ Health <span id="hpv">100</span></div><div class="bar"><div id="hp" class="fill"></div></div>

  <div>🍖 Hunger <span id="hv">100</span></div><div class="bar"><div id="h" class="fill"></div></div>

  <div>💧 Thirst <span id="tv">100</span></div><div class="bar"><div id="t" class="fill"></div></div>

  <div>⭐ Level <span id="lv">1</span> · XP <span id="xp">0</span></div>

 </div>

 <div id="top"><b>ISLAND: AFTERLIGHT</b><div style="font-size:11px">Find supplies. Stay alive.</div></div>

 <div id="inventory" class="panel">

  <b>INVENTORY</b><div>🪵 Wood: <span id="wood">0</span></div>

  <div>🪨 Stone: <span id="stone">0</span></div>

  <div>🔫 Ammo: <span id="ammo">12</span></div>

  <div>⚔️ Weapon: <span id="weapon">Club</span></div>

  <div>☠️ Kills: <span id="kills">0</span></div>

 </div>

 <div id="message">The island is not safe.</div>

 <div id="hint">Left side: move · Right side: fight</div>

</div>

<div id="controls">

 <div id="joy"><div id="knob"></div></div>

 <div class="buttons">

  <button id="attack">⚔️<br>MELEE</button>

  <button id="shoot">🔫<br>SHOOT</button>

  <button id="switch">SWITCH<br>WEAPON</button>

  <button id="gather">🪵<br>GATHER</button>

  <button id="eat">🍖<br>FOOD</button>

  <button id="build">🏕️<br>BUILD CAMP</button>

 </div>

</div>

<script type="module">

import * as THREE from 'https://cdn.jsdelivr.net/npm/three@0.160.0/build/three.module.js';

const scene=new THREE.Scene();

scene.background=new THREE.Color(0x9bb8b2);

scene.fog=new THREE.Fog(0x9bb8b2,35,105);

const camera=new THREE.PerspectiveCamera(65,innerWidth/innerHeight,.1,200);

const renderer=new THREE.WebGLRenderer({antialias:true});

renderer.setSize(innerWidth,innerHeight);

renderer.setPixelRatio(Math.min(devicePixelRatio,1.6));

renderer.shadowMap.enabled=true;

renderer.shadowMap.type=THREE.PCFSoftShadowMap;

document.body.appendChild(renderer.domElement);

scene.add(new THREE.HemisphereLight(0xdcecff,0x536044,2));

const sun=new THREE.DirectionalLight(0xffedcf,2.2);

sun.position.set(-20,35,15);sun.castShadow=true;

sun.shadow.mapSize.set(1024,1024);scene.add(sun);

const mat=(color,roughness=1)=>new THREE.MeshStandardMaterial({color,roughness});

const grass=mat(0x526f42),sand=mat(0xc8b98a),bark=mat(0x60452e),leaves=mat(0x24563a);

const stoneMat=mat(0x777d77),woodMat=mat(0x80603c);

const ground=new THREE.Mesh(new THREE.PlaneGeometry(180,180,32,32),grass);

ground.rotation.x=-Math.PI/2;ground.receiveShadow=true;scene.add(ground);

const beach=new THREE.Mesh(new THREE.RingGeometry(29,38,80),sand);

beach.rotation.x=-Math.PI/2;beach.position.y=.025;scene.add(beach);

const water=new THREE.Mesh(new THREE.PlaneGeometry(300,300),mat(0x326d83,.3));

water.rotation.x=-Math.PI/2;water.position.y=-.25;scene.add(water);

function box(parent,x,y,z,sx,sy,sz,material){

 const o=new THREE.Mesh(new THREE.BoxGeometry(sx,sy,sz),material);

 o.position.set(x,y,z);o.castShadow=true;o.receiveShadow=true;parent.add(o);return o;

}

function tree(x,z){

 const g=new THREE.Group();g.position.set(x,0,z);

 const trunk=new THREE.Mesh(new THREE.CylinderGeometry(.22,.38,3,7),bark);

 trunk.position.y=1.5;trunk.castShadow=true;g.add(trunk);

 for(let i=0;i<3;i++){

  const crown=new THREE.Mesh(new THREE.IcosahedronGeometry(1.5-i*.18,1),leaves);

  crown.position.set((Math.random()-.5)*.7,3.2+i*.45,(Math.random()-.5)*.7);

  crown.castShadow=true;g.add(crown);

 }

 scene.add(g);

}

const obstacles=[];

for(let i=0;i<100;i++){

 const a=Math.random()*Math.PI*2,r=9+Math.random()*65;

 const x=Math.cos(a)*r,z=Math.sin(a)*r;

 if(Math.hypot(x,z)<9)continue;

 tree(x,z);obstacles.push({x,z,r:1.1});

}

for(let i=0;i<35;i++){

 const x=(Math.random()-.5)*120,z=(Math.random()-.5)*120;

 if(Math.hypot(x,z)<10)continue;

 const rock=new THREE.Mesh(new THREE.DodecahedronGeometry(.5+Math.random()*.65,0),stoneMat);

 rock.position.set(x,.4,z);rock.castShadow=true;rock.receiveShadow=true;scene.add(rock);

 obstacles.push({x,z,r:.8});

}

// Abandoned island hut

const hut=new THREE.Group();hut.position.set(7,0,-7);scene.add(hut);

box(hut,0,1,0,5,2,.25,woodMat);

box(hut,0,1,-2.5,5,2,.25,woodMat);

box(hut,-2.5,1,-1.25,.25,2,2.5,woodMat);

box(hut,2.5,1,-1.25,.25,2,2.5,woodMat);

box(hut,0,2.2,-1.2,6,.25,3.5,bark);

// Player

const player=new THREE.Group();scene.add(player);

const bodyMat=mat(0x354d43),skin=mat(0xc39b79);

const body= new THREE.Mesh(new THREE.CapsuleGeometry(.42,.65,4,8),bodyMat);

body.position.y=1.05;body.castShadow=true;player.add(body);

const head=new THREE.Mesh(new THREE.SphereGeometry(.28,12,10),skin);

head.position.y=1.85;player.add(head);

const pack=box(player,0,1.12,.4,.42,.5,.25,mat(0x514433));

player.position.set(0,0,0);

function makeEnemy(type,x,z){

 const g=new THREE.Group();scene.add(g);g.position.set(x,0,z);

 const isZombie=type==='zombie';

 const m=mat(isZombie?0x6c8b68:0x8d5540);

 const torso=new THREE.Mesh(new THREE.CapsuleGeometry(.4,.65,3,7),m);

 torso.position.y=1;g.add(torso);torso.castShadow=true;

 const h=new THREE.Mesh(new THREE.SphereGeometry(.27,10,8),mat(isZombie?0x9aab83:0xb58a68));

 h.position.y=1.8;g.add(h);

 const legs=box(g,0,.3,0,.5,.6,.32,mat(0x343b33));

 return {g,type,hp:isZombie?45:70,alive:true,attack:0,speed:isZombie?1.25:1.65,damage:isZombie?7:10};

}

const enemies=[];

for(let i=0;i<9;i++){

 const a=Math.random()*Math.PI*2,r=12+Math.random()*35;

 enemies.push(makeEnemy(i<6?'zombie':'bandit',Math.cos(a)*r,Math.sin(a)*r));

}

const resources=[];

for(let i=0;i<28;i++){

 const a=Math.random()*Math.PI*2,r=4+Math.random()*48;

 const g=new THREE.Group();g.position.set(Math.cos(a)*r,0,Math.sin(a)*r);

 const isWood=Math.random()<.65;

 const mesh=new THREE.Mesh(new THREE.DodecahedronGeometry(.45,0),isWood?woodMat:stoneMat);

 mesh.position.y=.4;g.add(mesh);scene.add(g);

 resources.push({g,type:isWood?'wood':'stone',alive:true});

}

let hp=100,hunger=100,thirst=100,wood=0,stone=0,ammo=12,xp=0,level=1,kills=0;

let weapon='Club',messageTimer=0,attackCooldown=0,shootCooldown=0;

let joyX=0,joyY=0,camAngle=0,camPitch=.28;

let running=false,dead=false;

const $=id=>document.getElementById(id);

function say(s){$('message').textContent=s;$('message').style.display='block';messageTimer=2.8}

function refresh(){

 $('hpv').textContent=Math.ceil(hp);$('hv').textContent=Math.ceil(hunger);$('tv').textContent=Math.ceil(thirst);

 $('hp').style.width=hp+'%';$('h').style.width=hunger+'%';$('t').style.width=thirst+'%';

 $('hp').style.background=hp<30?'#e24d4d':'#60d37b';

 $('wood').textContent=wood;$('stone').textContent=stone;$('ammo').textContent=ammo;

 $('weapon').textContent=weapon;$('kills').textContent=kills;$('xp').textContent=xp;$('lv').textContent=level;

}

function gainXP(n){xp+=n;if(xp>=level*100){xp-=level*100;level++;hp=Math.min(100,hp+20);say('LEVEL UP! Level '+level)}}

function nearestEnemy(max=3.3){

 let best=null,dist=max;

 for(const e of enemies)if(e.alive){

  const d=e.g.position.distanceTo(player.position);

  if(d<dist){dist=d;best=e}

 }

 return best;

}

function damageEnemy(e,n){

 e.hp-=n;

 if(e.hp<=0){

  e.alive=false;scene.remove(e.g);kills++;gainXP(e.type==='zombie'?25:40);

  if(Math.random()<.6)ammo+=3;

  say((e.type==='zombie'?'Zombie':'Bandit')+' defeated! Loot collected.');

 }

}

function melee(){

 if(dead||attackCooldown>0)return;

 attackCooldown=.55;

 let e=nearestEnemy(3.5);

 if(e){damageEnemy(e,weapon==='Axe'?55:35);say('You hit the '+e.type+'!')}

 else say('No enemy in melee range.');

}

function shoot(){

 if(dead||shootCooldown>0)return;

 if(ammo<=0){say('Out of ammunition!');return}

 ammo--;shootCooldown=.32;

 // Aim at the closest enemy roughly in front of the player.

 let best=null,bd=24;

 const forward=new THREE.Vector3(Math.sin(player.rotation.y),0,Math.cos(player.rotation.y));

 for(const e of enemies)if(e.alive){

  const delta=e.g.position.clone().sub(player.position);const d=delta.length();

  if(d<bd&&forward.dot(delta.normalize())>.55){best=e;bd=d}

 }

 if(best){damageEnemy(best,45);say('Shot landed!')}

 else say('Shot fired — target missed.');

 refresh();

}

function gather(){

 if(dead)return;

 let best=null,bd=4;

 for(const r of resources)if(r.alive){

  const d=r.g.position.distanceTo(player.position);

  if(d<bd){best=r;bd=d}

 }

 if(best){best.alive=false;scene.remove(best.g);

  if(best.type==='wood')wood+=3;else stone+=2;

  say('Collected '+best.type+'.');refresh();

 }else say('Move closer to a resource.');

}

function build(){

 if(wood<5||stone<3){say('Camp needs 5 wood and 3 stone. Gather more.');return}

 wood-=5;stone-=3;

 const camp=new THREE.Group();camp.position.copy(player.position);

 const fire=new THREE.Mesh(new THREE.ConeGeometry(.35,.8,7),mat(0xff7a28,{roughness:.8}));

 fire.position.y=.5;camp.add(fire);

 const base=new THREE.Mesh(new THREE.CylinderGeometry(.8,.8,.12,10),woodMat);

 base.position.y=.08;camp.add(base);scene.add(camp);

 gainXP(15);say('Camp built! You earned 15 XP.');refresh();

}

$('attack').onclick=melee;$('shoot').onclick=shoot;

$('gather').onclick=gather;$('build').onclick=build;

$('switch').onclick=()=>{weapon=weapon==='Club'?'Axe':'Club';say('Equipped '+weapon);refresh()};

$('eat').onclick=()=>{hunger=Math.min(100,hunger+25);thirst=Math.max(0,thirst-2);say('You ate some supplies.');refresh()};

const joy=$('joy'),knob=$('knob');

let joyId=null,joyCenter={x:0,y:0};

joy.addEventListener('pointerdown',e=>{

 joyId=e.pointerId;joy.setPointerCapture(joyId);

 const r=joy.getBoundingClientRect();joyCenter={x:r.left+r.width/2,y:r.top+r.height/2};

 moveJoy(e);

});

function moveJoy(e){

 if(e.pointerId!==joyId)return;

 let dx=e.clientX-joyCenter.x,dy=e.clientY-joyCenter.y;

 const max=40,d=Math.hypot(dx,dy)||1;if(d>max){dx=dx/d*max;dy=dy/d*max}

 knob.style.left=(36+dx)+'px';knob.style.top=(36+dy)+'px';

 joyX=dx/max;joyY=dy/max;

}

joy.addEventListener('pointermove',moveJoy);

function endJoy(e){if(e.pointerId!==joyId)return;joyId=null;joyX=0;joyY=0;knob.style.left='36px';knob.style.top='36px'}

joy.addEventListener('pointerup',endJoy);joy.addEventListener('pointercancel',endJoy);

// Drag on the right side of the screen to rotate the camera.

let lookId=null,lastLook={x:0,y:0};

renderer.domElement.addEventListener('pointerdown',e=>{

 if(e.clientX<innerWidth*.38)return;

 lookId=e.pointerId;lastLook={x:e.clientX,y:e.clientY};

});

renderer.domElement.addEventListener('pointermove',e=>{

 if(e.pointerId!==lookId)return;

 const dx=e.clientX-lastLook.x,dy=e.clientY-lastLook.y;

 camAngle-=dx*.006;camPitch=THREE.MathUtils.clamp(camPitch+dy*.003,-.1,.75);

 lastLook={x:e.clientX,y:e.clientY};

});

function endLook(e){if(e.pointerId===lookId)lookId=null}

renderer.domElement.addEventListener('pointerup',endLook);

renderer.domElement.addEventListener('pointercancel',endLook);

const clock=new THREE.Clock();let elapsed=0;

function update(dt){

 if(!running)return;

 elapsed+=dt;

 attackCooldown=Math.max(0,attackCooldown-dt);shootCooldown=Math.max(0,shootCooldown-dt);

 hunger=Math.max(0,hunger-dt*.12);thirst=Math.max(0,thirst-dt*.19);

 if((hunger<=0||thirst<=0)&&elapsed%2<dt)hp=Math.max(0,hp-1);

 // Move relative to camera direction.

 const forward=new THREE.Vector3(-Math.sin(camAngle),0,-Math.cos(camAngle));

 const right=new THREE.Vector3(Math.cos(camAngle),0,-Math.sin(camAngle));

 const dir=forward.multiplyScalar(-joyY).add(right.multiplyScalar(joyX));

 if(dir.lengthSq()>.01){

  dir.normalize();player.position.addScaledVector(dir,dt*(joyY<-.2?5.5:3.5));

  player.rotation.y=Math.atan2(dir.x,dir.z);

 }

 player.position.x=THREE.MathUtils.clamp(player.position.x,-78,78);

 player.position.z=THREE.MathUtils.clamp(player.position.z,-78,78);

 // Basic enemy AI: wander until close, then chase and attack.

 for(const e of enemies)if(e.alive){

  const delta=player.position.clone().sub(e.g.position);const d=delta.length();

  if(d<20&&d>1.45){

   delta.y=0;delta.normalize();e.g.position.addScaledVector(delta,e.speed*dt);

   e.g.rotation.y=Math.atan2(delta.x,delta.z);

  }else if(d<=1.45){

   e.attack-=dt;

   if(e.attack<=0){e.attack=1.25;hp=Math.max(0,hp-e.damage);say(e.type==='zombie'?'A zombie attacked you!':'A bandit shot/struck you!')}

  }

 }

 const target=new THREE.Vector3(player.position.x,1.2,player.position.z);

 const camDist=7;

 camera.position.set(

  player.position.x+Math.sin(camAngle)*camDist,

  player.position.y+3+camPitch*5,

  player.position.z+Math.cos(camAngle)*camDist

 );

 camera.lookAt(target);

 if(messageTimer>0){messageTimer-=dt;if(messageTimer<=0)$('message').style.display='none'}

 if(hp<=0&&!dead){

  dead=true;running=false;say('YOU DIED — refresh the page to restart.');

  $('hint').textContent='You were lost on the island.';

 }

 refresh();

}

function animate(){

 requestAnimationFrame(animate);

 const dt=Math.min(clock.getDelta(),.05);

 update(dt);renderer.render(scene,camera);

}

animate();

addEventListener('resize',()=>{

 camera.aspect=innerWidth/innerHeight;camera.updateProjectionMatrix();

 renderer.setSize(innerWidth,innerHeight);

});

$('play').onclick=()=>{

 $('start').style.display='none';running=true;clock.getDelta();

 say('You washed ashore. Find supplies and survive.');refresh();

};

</script>

</body>

</html>
